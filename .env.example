# ==============================================================================
# BrandSentinel AI - Environment Configuration Example
# Copy this file to .env.local or .env and supply your project credentials.
# Only VITE_ prefixed keys are exposed to the browser client bundle.
# ==============================================================================

# --- Client-Side Safe (Exposed in Vite Browser Bundle) ---
# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Public Key (SAFE for browser exposure with RLS)
# DO NOT place service_role secret keys in this variable!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Server-Side Only (NEVER prefix with VITE_, NEVER expose to client) ---
# Google Gemini API Key (used by backend server / endpoints for embeddings and RAG audit)
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Service Role / Secret Key (used only by backend server for admin operations)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key-here
